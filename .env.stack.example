# start_all creates .env.stack automatically with random passwords.
# This stack never uses or overwrites the existing development .env.
STACK_PROJECT_NAME=legacy-moderniser
STACK_ORACLE_PASSWORD=replace_with_random_password
STACK_DEMO_PASSWORD=replace_with_random_password
STACK_PG_PASSWORD=replace_with_random_password
STACK_META_PASSWORD=replace_with_random_password
STACK_ADMIN_PASSWORD=replace_with_random_password
STACK_READER_PASSWORD=replace_with_24_random_hex_characters
STACK_API_PORT=18000
STACK_WEB_PORT=18501
# ollama is automatic and needs no account. The small model is for demos;
# choose a larger model for more demanding translation, or use groq.
STACK_AI_PROVIDER=none
STACK_OLLAMA_MODEL=qwen2.5-coder:1.5b
STACK_GROQ_API_KEY=
STACK_GROQ_MODEL=openai/gpt-oss-120b
