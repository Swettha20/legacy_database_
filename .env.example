# Copy to .env and fill in real values. Never commit .env (it is gitignored).

# --- Databases (already in your .env) ---
ORACLE_USER=system
ORACLE_PASSWORD=change_me
ORACLE_DSN=localhost:1521/XEPDB1
# Which Oracle schema to migrate (default: the user above) and, optionally,
# which of its tables. Leave ORACLE_TABLES empty to discover every table the
# schema owns (Oracle's own tables are excluded automatically).
# ORACLE_SCHEMA=SYSTEM
# ORACLE_TABLES=MEMBERS,BOOKS,LOANS
PG_HOST=localhost
PG_PORT=5432
PG_USER=postgres
PG_PASSWORD=change_me
PG_DBNAME=modernized_db

# --- AI provider: "ollama" (local, default) or "groq" (free cloud API) ---
LLM_PROVIDER=ollama

# Ollama (used when LLM_PROVIDER=ollama)
OLLAMA_URL=http://localhost:11434/api/generate
OLLAMA_MODEL=codellama:7b

# Groq (used when LLM_PROVIDER=groq) - key from console.groq.com
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
LLM_TEMPERATURE=0.2
